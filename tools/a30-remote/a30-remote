#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
DATA="${XDG_STATE_HOME:-$HOME/.local/state}/a30-remote"
KEY="$HOME/.ssh/a30_remote_ed25519"
ADB="$ROOT/bin/adb"
SCRCPY="$ROOT/bin/scrcpy"
SERIAL=RQ8M70A9WBP
DEST=100.65.49.34
mkdir -p -- "$DATA"
chmod 700 "$DATA"
CONFIG="$DATA/ssh_config"
for dependency in ssh python3; do
    command -v "$dependency" >/dev/null || { echo "Dependencia ausente: $dependency" >&2; exit 1; }
done
{
    printf 'Host %s\n  HostName 100.65.49.34\n  Port 8022\n  User u0_a267\n' "$DEST"
    printf '  HostKeyAlgorithms ssh-ed25519\n  StrictHostKeyChecking yes\n'
    printf '  UserKnownHostsFile "%s"\n' "$ROOT/known_hosts"
    printf '  ConnectTimeout 10\n  ServerAliveInterval 20\n  ServerAliveCountMax 3\n'
    [[ ! -f "$KEY" ]] || printf '  IdentityFile "%s"\n' "$KEY"
    printf 'Include "%s"\n' "$HOME/.ssh/config"
} > "$CONFIG"
chmod 600 "$CONFIG"
SSH=(ssh -F "$CONFIG")
tunnel_pid=''
endpoint=''
cleanup() {
    if [[ -n "$endpoint" ]]; then "$ADB" disconnect "$endpoint" >/dev/null 2>&1 || true; endpoint=''; fi
    if [[ -n "$tunnel_pid" ]]; then kill "$tunnel_pid" 2>/dev/null || true; wait "$tunnel_pid" 2>/dev/null || true; tunnel_pid=''; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
fail() { echo "ERRO: $*" >&2; return 1; }
test_ssh() { "${SSH[@]}" -n -o BatchMode=yes "$DEST" true; }
setup_ssh() {
    if test_ssh; then echo 'SSH ja autorizado nesta maquina.'; return; fi
    command -v ssh-keygen >/dev/null || { fail 'Instale openssh-client.'; return 1; }
    mkdir -p -- "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if [[ ! -f "$KEY" ]]; then ssh-keygen -q -t ed25519 -N '' -C a30-remote-client -f "$KEY"; fi
    # Esta IdentityFile e local; a chave privada nunca entra no pacote.
    if ! grep -q 'IdentityFile' "$CONFIG"; then printf 'Host %s\n  IdentityFile "%s"\n' "$DEST" "$KEY" >> "$CONFIG"; fi
    local encoded
    encoded="$(base64 < "$KEY.pub" | tr -d '\n')"
    echo 'Digite a senha SSH do Termux para cadastrar apenas a chave publica desta maquina.'
    echo 'Se o Termux nao tem senha configurada, execute passwd nele primeiro.'
    if ! "${SSH[@]}" -o BatchMode=no "$DEST" sh -s <<REMOTE
set -e
umask 077
mkdir -p "\$HOME/.ssh"
touch "\$HOME/.ssh/authorized_keys"
k=\$(printf '%s' '$encoded' | base64 -d)
grep -qxF "\$k" "\$HOME/.ssh/authorized_keys" || printf '\\n%s\\n' "\$k" >> "\$HOME/.ssh/authorized_keys"
chmod 700 "\$HOME/.ssh"
chmod 600 "\$HOME/.ssh/authorized_keys"
REMOTE
    then
        cat "$KEY.pub"
        fail 'Adicione a chave publica acima ao ~/.ssh/authorized_keys do Termux. Nunca copie a chave privada de outro computador.'
        return 1
    fi
    test_ssh || { fail 'Cadastro enviado, mas autenticacao por chave falhou.'; return 1; }
    echo 'SSH configurado. A chave privada ficou somente nesta maquina.'
}
usb_setup() {
    "$ADB" devices | grep -Eq "^${SERIAL}[[:space:]]+device[[:space:]]*$" || { fail 'Conecte o A30 por USB nesta maquina e autorize a chave ADB no Android.'; return 1; }
    "$ADB" -s "$SERIAL" tcpip 5555 || return 1
    sleep 2
}
session() {
    local action="${1:-conectar}" port state actual authorized=0 code=0
    test_ssh || { fail 'Entre na mesma tailnet e execute a30-remote configurar-ssh.'; return 1; }
    "${SSH[@]}" -o BatchMode=yes "$DEST" sh -s <<'REMOTE' || { fail 'ADB TCP desligado. Ative por USB em uma maquina autorizada.'; return 1; }
python -c 'import socket; s=socket.create_connection(("127.0.0.1",5555),5); s.close()'
REMOTE
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    endpoint="127.0.0.1:$port"
    "${SSH[@]}" -n -o BatchMode=yes -o ExitOnForwardFailure=yes -N -T -L "127.0.0.1:$port:127.0.0.1:5555" "$DEST" 2> "$DATA/ssh-session.log" &
    tunnel_pid=$!
    sleep 2
    kill -0 "$tunnel_pid" 2>/dev/null || { cat "$DATA/ssh-session.log" >&2; cleanup; return 1; }
    "$ADB" connect "$endpoint" || { cleanup; return 1; }
    echo 'Se aparecer uma solicitacao ADB no A30, aceite a chave desta maquina.'
    for ((attempt=0; attempt<30; attempt++)); do
        state="$("$ADB" -s "$endpoint" get-state 2>/dev/null || true)"
        if [[ "$state" == device ]]; then authorized=1; break; fi
        sleep 1
    done
    if [[ "$authorized" != 1 ]]; then cleanup; fail 'ADB nao autorizado: aceite no Android ou autorize esta maquina por USB.'; return 1; fi
    actual="$("$ADB" -s "$endpoint" shell getprop ro.serialno | tr -d '\r')"
    if [[ "$actual" != "$SERIAL" ]]; then cleanup; fail 'O aparelho recebido nao e o A30 esperado.'; return 1; fi
    if [[ "$action" == desativar-adb ]]; then
        "$ADB" -s "$endpoint" usb || { cleanup; return 1; }
        sleep 2
        "${SSH[@]}" -o BatchMode=yes "$DEST" sh -s <<'REMOTE' || { cleanup; fail 'Nao foi possivel confirmar o fechamento de 5555.'; return 1; }
python -c 'import socket,sys; s=socket.socket(); s.settimeout(3); r=s.connect_ex(("127.0.0.1",5555)); s.close(); sys.exit(0 if r else 1)'
REMOTE
        cleanup
        echo 'ADB TCP desativado. Para conectar novamente, reative por USB.'
        return
    fi
    local options=(--serial="$endpoint" --force-adb-forward --no-audio --max-size=1280 --max-fps=30 --video-bit-rate=4M --window-title=A30-Remoto --verbosity=debug)
    if [[ "$action" == testar ]]; then options+=(--time-limit=6); fi
    echo 'Abrindo tela. Fechar o scrcpy encerra este tunel, mantendo ADB TCP para reconectar.'
    ADB="$ADB" "$SCRCPY" "${options[@]}" > "$DATA/scrcpy.stdout.log" 2> "$DATA/scrcpy.stderr.log" || code=$?
    cleanup
    if ((code)); then cat "$DATA/scrcpy.stderr.log" >&2; return "$code"; fi
    if [[ "$action" == testar ]] && ! grep -q Texture "$DATA/scrcpy.stdout.log" "$DATA/scrcpy.stderr.log"; then fail 'Teste terminou sem confirmar decodificacao de video.'; return 1; fi
    echo 'Sessao concluida.'
}
diagnostics() {
    "$ADB" version || return 1
    "$SCRCPY" --version || return 1
    "$ADB" devices -l || return 1
    test_ssh || return 1
    "${SSH[@]}" -n -o BatchMode=yes "$DEST" 'getprop ro.product.model; getprop service.adb.tcp.port' || return 1
    echo 'SSH e chave do servidor conferidos. Nenhum servico remoto foi alterado.'
}
execute() {
    case "${1:-menu}" in
        conectar|testar|desativar-adb) session "$1" ;;
        usb) usb_setup && session conectar ;;
        configurar-ssh) setup_ssh ;;
        diagnostico) diagnostics ;;
        ajuda|--help|-h) cat "$ROOT/LEIA-ME.txt" ;;
        *) fail 'Opcoes: conectar, usb, configurar-ssh, diagnostico, desativar-adb, testar, ajuda'; return 1 ;;
    esac
}
if [[ "${1:-menu}" != menu ]]; then execute "$1"; exit $?; fi
while true; do
    printf '\nA30 REMOTO - SSH pela tailnet\n1 Conectar tela\n2 Ativar ADB TCP por USB e conectar\n3 Configurar SSH desta maquina\n4 Diagnostico\n5 Desativar ADB TCP (exige USB para voltar)\n6 Instrucoes\n0 Sair\n'
    read -r -p 'Opcao: ' choice || break
    case "$choice" in
        0) break ;;
        1) execute conectar || true ;;
        2) execute usb || true ;;
        3) execute configurar-ssh || true ;;
        4) execute diagnostico || true ;;
        5) read -r -p 'Isso corta o ADB remoto. Digite DESATIVAR: ' confirm; [[ "$confirm" != DESATIVAR ]] || execute desativar-adb || true ;;
        6) execute ajuda ;;
    esac
done
